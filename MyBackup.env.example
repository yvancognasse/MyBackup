# Example only. Copy to MyBackup.env and set your local paths/account folder.
SOURCE_DIRS=/absolute/path/to/source
DRIVE_FOLDER_NAME=MyBackup
DRIVE_PARENT_ID=
SKIP_HIDDEN=true
DELETE_REMOVED=false
MAX_WORKERS=4
UPLOAD_CHUNK_MB=8
SMALL_FILE_LIMIT_MB=4
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
HTTP_TIMEOUT_SECONDS=60
CACHE_SAVE_EVERY=100
